    <!-- Privacy -->
    <string name="privacy_title">Privacy Policy</string>
    <string name="privacy_intro">ChopCal respects your privacy. This policy explains what data we collect and how we use it.</string>
    <string name="privacy_section_data">What we collect</string>
    <string name="privacy_section_data_body">Your goal, height, weight, meal records, steps and water intake, plus an anonymous device ID.</string>
    <string name="privacy_section_use">How we use it</string>
    <string name="privacy_section_use_body">To estimate calories, build your trends, and personalize your daily plan. We do not sell your data to third parties.</string>
    <string name="privacy_section_storage">Storage &amp; analytics</string>
    <string name="privacy_section_storage_body">Your data stays on your device. We use Firebase only for anonymous analytics and crash reports to improve the app.</string>
